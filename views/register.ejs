<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Register - Todo App</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://unpkg.com/lucide@latest"></script>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap');
    body { font-family: 'Plus Jakarta Sans', sans-serif; }
  </style>
</head>
<body class="bg-[#F0F2F5] min-h-screen flex items-center justify-center p-4">

  <div class="bg-white/80 backdrop-blur-xl p-8 rounded-[32px] shadow-2xl border border-white/50 w-full max-w-md">
    
    <!-- Header -->
    <div class="text-center mb-6">
      <div class="w-12 h-12 bg-indigo-100 text-indigo-600 rounded-2xl flex items-center justify-center mx-auto mb-3 shadow-sm">
        <i data-lucide="user-plus" class="w-6 h-6"></i>
      </div>
      <h2 class="text-2xl font-bold text-gray-800">Daftar Akun Baru</h2>
      <p class="text-xs text-gray-400 mt-1">Buat akun untuk mulai mengelola tugas harianmu</p>
    </div>

    <!-- Alert Pesan Error / Sukses -->
    <div id="alert-msg" class="hidden mb-4 p-3 rounded-xl text-xs font-semibold text-center"></div>

    <!-- Form Register -->
    <form id="register-form" onsubmit="handleRegister(event)" class="space-y-4">
      <div>
        <label class="block text-xs font-bold text-gray-500 uppercase tracking-wider mb-1.5">Username</label>
        <div class="relative">
          <input 
            type="text" 
            id="username" 
            required 
            placeholder="Masukkan username" 
            class="w-full pl-10 pr-4 py-3 rounded-xl bg-gray-50 border border-gray-200 focus:outline-none focus:ring-2 focus:ring-indigo-500 text-sm"
          >
          <i data-lucide="user" class="w-4 h-4 text-gray-400 absolute left-3.5 top-3.5"></i>
        </div>
      </div>

      <div>
        <label class="block text-xs font-bold text-gray-500 uppercase tracking-wider mb-1.5">Password</label>
        <div class="relative">
          <input 
            type="password" 
            id="password" 
            required 
            placeholder="Masukkan password" 
            class="w-full pl-10 pr-4 py-3 rounded-xl bg-gray-50 border border-gray-200 focus:outline-none focus:ring-2 focus:ring-indigo-500 text-sm"
          >
          <i data-lucide="lock" class="w-4 h-4 text-gray-400 absolute left-3.5 top-3.5"></i>
        </div>
      </div>

      <button 
        type="submit" 
        class="w-full bg-indigo-600 hover:bg-indigo-700 text-white font-semibold py-3 rounded-xl shadow-lg shadow-indigo-200 transition active:scale-[0.98] text-sm mt-2"
      >
        Daftar Sekarang
      </button>
    </form>

    <!-- Link ke Halaman Login -->
    <div class="mt-6 text-center">
      <p class="text-xs text-gray-500">
        Sudah punya akun? 
        <a href="/login" class="text-indigo-600 font-bold hover:underline">Login di sini</a>
      </p>
    </div>

  </div>

  <script>
    lucide.createIcons();

    async function handleRegister(e) {
      e.preventDefault();
      
      const username = document.getElementById('username').value.trim();
      const password = document.getElementById('password').value;
      const alertMsg = document.getElementById('alert-msg');

      try {
        const res = await fetch('/api/auth/register', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ username, password })
        });

        const data = await res.json();

        if (res.ok) {
          alertMsg.className = "mb-4 p-3 rounded-xl text-xs font-semibold text-center bg-emerald-50 text-emerald-600 border border-emerald-200";
          alertMsg.innerText = "Registrasi berhasil! Mengalihkan ke halaman login...";
          alertMsg.classList.remove('hidden');

          setTimeout(() => {
            window.location.href = '/login';
          }, 1500);
        } else {
          alertMsg.className = "mb-4 p-3 rounded-xl text-xs font-semibold text-center bg-red-50 text-red-600 border border-red-200";
          alertMsg.innerText = data.message || "Gagal mendaftar. Username mungkin sudah dipakai.";
          alertMsg.classList.remove('hidden');
        }
      } catch (err) {
        alertMsg.className = "mb-4 p-3 rounded-xl text-xs font-semibold text-center bg-red-50 text-red-600 border border-red-200";
        alertMsg.innerText = "Terjadi kesalahan koneksi server.";
        alertMsg.classList.remove('hidden');
      }
    }
  </script>
</body>
</html>