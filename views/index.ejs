<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Dashboard Todo</title>
  <!-- Tailwind CSS & Lucide Icons -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://unpkg.com/lucide@latest"></script>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap');
    body { font-family: 'Plus Jakarta Sans', sans-serif; }
  </style>
</head>
<body class="bg-[#F0F2F5] min-h-screen flex justify-center items-center p-4">

  <!-- Container Dashboard -->
  <div class="w-full max-w-md bg-white/80 backdrop-blur-xl rounded-[32px] p-6 shadow-2xl border border-white/50 relative overflow-hidden my-6">

<!-- Top Bar / Header -->
    <div class="flex items-center justify-between mb-6">
      <div class="flex items-center gap-3">
        <!-- Inisial Huruf Pertama Username (Kapital) -->
        <div class="w-12 h-12 rounded-full bg-indigo-500 text-white text-lg font-bold flex items-center justify-center shadow-md uppercase">
          <%= user.username.charAt(0) %>
        </div>
        <div>
          <span class="text-xs text-gray-400 font-medium">Welcome Back 👋</span>
          <!-- Nama User Dinamis -->
          <h2 class="text-base font-bold text-gray-800 leading-none capitalize">
            <%= user.username %>
          </h2>
        </div>
      </div>
      <button onclick="logout()" class="w-10 h-10 rounded-full bg-red-50 hover:bg-red-100 text-red-500 flex items-center justify-center transition shadow-sm" title="Logout">
        <i data-lucide="log-out" class="w-5 h-5"></i>
      </button>
    </div>

    <!-- Overview Statistics Cards -->
    <div class="mb-6">
      <div class="flex justify-between items-center mb-3">
        <h3 class="font-bold text-gray-800 text-lg">Overview</h3>
        <span class="text-xs bg-gray-100 text-gray-500 font-medium px-3 py-1 rounded-full">All Time</span>
      </div>
      
      <div class="grid grid-cols-2 gap-3">
        <!-- Total Card -->
        <div class="bg-[#EEF2FF] p-4 rounded-2xl flex flex-col justify-between border border-indigo-100 shadow-sm">
          <div class="flex justify-between items-start">
            <span id="stat-total" class="text-2xl font-bold text-indigo-900">0</span>
            <i data-lucide="check-square" class="w-5 h-5 text-indigo-400"></i>
          </div>
          <span class="text-xs font-semibold text-indigo-600 mt-2">Total Tasks</span>
        </div>

        <!-- Pending Card -->
        <div class="bg-[#FEF3C7] p-4 rounded-2xl flex flex-col justify-between border border-amber-100 shadow-sm">
          <div class="flex justify-between items-start">
            <span id="stat-pending" class="text-2xl font-bold text-amber-900">0</span>
            <i data-lucide="clock" class="w-5 h-5 text-amber-500"></i>
          </div>
          <span class="text-xs font-semibold text-amber-600 mt-2">In Progress</span>
        </div>

        <!-- Completed Card -->
        <div class="bg-[#DCFCE7] p-4 rounded-2xl flex flex-col justify-between border border-emerald-100 shadow-sm col-span-2">
          <div class="flex justify-between items-center">
            <div>
              <span id="stat-done" class="text-2xl font-bold text-emerald-900">0</span>
              <span class="text-xs font-semibold text-emerald-600 ml-2">Completed Tasks</span>
            </div>
            <i data-lucide="sparkles" class="w-5 h-5 text-emerald-500"></i>
          </div>
        </div>
      </div>
    </div>

    <!-- Main Section: Task List -->
    <div class="mb-20">
      <div class="flex justify-between items-center mb-3">
        <h3 class="font-bold text-gray-800 text-lg">Today's Task</h3>
        <button onclick="loadTodos()" class="text-indigo-600 hover:text-indigo-800">
          <i data-lucide="rotate-cw" class="w-4 h-4"></i>
        </button>
      </div>

      <!-- Todo List Container -->
      <div id="todo-container" class="space-y-3 max-h-[350px] overflow-y-auto pr-1">
        <p class="text-center text-gray-400 py-6 text-sm">Memuat tugas...</p>
      </div>
    </div>

    <!-- Floating Bottom Bar / Add Task Trigger -->
    <div class="absolute bottom-4 left-6 right-6 bg-gray-900/90 backdrop-blur-md text-white rounded-full p-2 flex items-center justify-between shadow-2xl border border-gray-800">
      <div class="flex items-center gap-3 pl-4">
        <i data-lucide="calendar" class="w-5 h-5 text-indigo-400"></i>
        <span class="text-xs font-medium text-gray-300">New Task Input</span>
      </div>
      <button onclick="openAddModal()" class="w-10 h-10 rounded-full bg-indigo-600 hover:bg-indigo-500 text-white flex items-center justify-center transition shadow-lg active:scale-95">
        <i data-lucide="plus" class="w-6 h-6"></i>
      </button>
    </div>

  </div>

  <!-- Modal Add / Edit Task -->
  <div id="task-modal" class="fixed inset-0 bg-black/40 backdrop-blur-sm hidden flex items-center justify-center p-4 z-50">
    <div class="bg-white rounded-3xl p-6 w-full max-w-sm shadow-2xl border border-gray-100">
      <div class="flex justify-between items-center mb-4">
        <h3 id="modal-title" class="font-bold text-gray-800 text-lg">Tambah Tugas Baru</h3>
        <button onclick="closeModal()" class="text-gray-400 hover:text-gray-600">
          <i data-lucide="x" class="w-5 h-5"></i>
        </button>
      </div>
      
      <form id="modal-form" onsubmit="handleFormSubmit(event)">
        <input type="hidden" id="modal-todo-id">
        <div class="mb-4">
          <label class="block text-xs font-bold text-gray-500 uppercase tracking-wider mb-2">Title</label>
          <input 
            type="text" 
            id="modal-todo-title" 
            required 
            placeholder="Contoh: Audit UI/UX Website" 
            class="w-full px-4 py-3 rounded-xl bg-gray-50 border border-gray-200 focus:outline-none focus:ring-2 focus:ring-indigo-500 text-sm"
          >
        </div>

        <div class="flex gap-2">
          <button type="button" onclick="closeModal()" class="flex-1 py-3 rounded-xl border border-gray-200 text-gray-600 text-sm font-semibold hover:bg-gray-50">
            Batal
          </button>
          <button type="submit" class="flex-1 py-3 rounded-xl bg-indigo-600 text-white text-sm font-semibold hover:bg-indigo-700 shadow-md">
            Simpan
          </button>
        </div>
      </form>
    </div>
  </div>

  <!-- Client-side Logic (Fetch API) -->
  <script>
    lucide.createIcons();
    let currentEditId = null;

    // 1. Fetch data dari /api/todos
    async function loadTodos() {
      try {
        const res = await fetch('/api/todos');
        if (res.status === 401) {
          window.location.href = '/login';
          return;
        }

        const result = await res.json();
        const todos = result.data || [];
        renderUI(todos);
      } catch (err) {
        console.error('Error fetching todos:', err);
      }
    }

    // 2. Render UI List dan Statistik Overview
    function renderUI(todos) {
      const container = document.getElementById('todo-container');
      
      // Update Statistik
      const total = todos.length;
      const done = todos.filter(t => t.is_done).length;
      const pending = total - done;

      document.getElementById('stat-total').innerText = total;
      document.getElementById('stat-done').innerText = done;
      document.getElementById('stat-pending').innerText = pending;

      container.innerHTML = '';

      if (todos.length === 0) {
        container.innerHTML = `
          <div class="text-center py-8">
            <div class="w-12 h-12 bg-gray-100 text-gray-400 rounded-full flex items-center justify-center mx-auto mb-2">
              <i data-lucide="inbox" class="w-6 h-6"></i>
            </div>
            <p class="text-xs text-gray-400">Belum ada tugas hari ini</p>
          </div>
        `;
        lucide.createIcons();
        return;
      }

      todos.forEach(todo => {
        const card = document.createElement('div');
        card.className = `p-4 rounded-2xl border transition shadow-sm flex items-start justify-between gap-3 ${
          todo.is_done ? 'bg-gray-50/80 border-gray-200' : 'bg-white border-gray-100 hover:border-indigo-200'
        }`;

        card.innerHTML = `
          <div class="flex items-start gap-3 flex-1">
            <button onclick="toggleDone(${todo.id}, ${!todo.is_done})" class="mt-0.5">
              ${
                todo.is_done 
                  ? '<div class="w-5 h-5 rounded-full bg-emerald-500 text-white flex items-center justify-center"><i data-lucide="check" class="w-3.5 h-3.5"></i></div>'
                  : '<div class="w-5 h-5 rounded-full border-2 border-gray-300 hover:border-indigo-500"></div>'
              }
            </button>
            <div class="flex-1">
              <span class="text-[10px] font-bold uppercase tracking-wider text-indigo-500 mb-0.5 block">Task</span>
              <p class="text-sm font-semibold ${todo.is_done ? 'line-through text-gray-400' : 'text-gray-800'} leading-snug">
                ${escapeHtml(todo.title)}
              </p>
            </div>
          </div>

          <div class="flex items-center gap-1">
            <button onclick="openEditModal(${todo.id}, '${escapeHtml(todo.title)}')" class="w-8 h-8 rounded-lg text-gray-400 hover:text-indigo-600 hover:bg-indigo-50 flex items-center justify-center transition">
              <i data-lucide="pencil" class="w-4 h-4"></i>
            </button>
            <button onclick="deleteTodo(${todo.id})" class="w-8 h-8 rounded-lg text-gray-400 hover:text-red-600 hover:bg-red-50 flex items-center justify-center transition">
              <i data-lucide="trash-2" class="w-4 h-4"></i>
            </button>
          </div>
        `;
        container.appendChild(card);
      });

      lucide.createIcons();
    }

    // 3. Modal Controls
    function openAddModal() {
      currentEditId = null;
      document.getElementById('modal-title').innerText = 'Tambah Tugas Baru';
      document.getElementById('modal-todo-title').value = '';
      document.getElementById('task-modal').classList.remove('hidden');
    }

    function openEditModal(id, title) {
      currentEditId = id;
      document.getElementById('modal-title').innerText = 'Edit Tugas';
      document.getElementById('modal-todo-title').value = title;
      document.getElementById('task-modal').classList.remove('hidden');
    }

    function closeModal() {
      document.getElementById('task-modal').classList.add('hidden');
    }

    // 4. Form Submit (Create & Update Title)
    async function handleFormSubmit(event) {
      event.preventDefault();
      const title = document.getElementById('modal-todo-title').value.trim();

      if (!title) return;

      if (currentEditId) {
        // Edit Mode
        await fetch(`/api/todos/${currentEditId}`, {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ title })
        });
      } else {
        // Create Mode
        await fetch('/api/todos', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ title })
        });
      }

      closeModal();
      loadTodos();
    }

    // 5. Update Status Checkbox
    async function toggleDone(id, is_done) {
      await fetch(`/api/todos/${id}`, {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ is_done })
      });
      loadTodos();
    }

    // 6. Delete Todo
    async function deleteTodo(id) {
      if (!confirm('Hapus tugas ini?')) return;
      await fetch(`/api/todos/${id}`, { method: 'DELETE' });
      loadTodos();
    }

    // Logout
    async function logout() {
      await fetch('/api/auth/logout', { method: 'POST' });
      window.location.href = '/login';
    }

    function escapeHtml(str) {
      return str.replace(/[&<>'"]/g, tag => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', "'": '&#39;', '"': '&quot;' }[tag] || tag));
    }

    // Initial Load
    loadTodos();
  </script>
</body>
</html>